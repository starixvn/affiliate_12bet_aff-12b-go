<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Output format -->
          <Format>cobertura</Format>
          <!-- Exclude files from coverage calculation - synchronized with sonar.coverage.exclusions -->
          <ExcludeByFile>
            **/Fanex.Affiliate.Link/Program.cs;
            **/Fanex.Affiliate.Link.Consumer/Program.cs;
            **/Fanex.Affiliate.Link/Services/HealthCheck/**/*.cs;
            **/Fanex.Affiliate.Link/Models/HealthCheck/**/*.cs;
            **/Fanex.Affiliate.Link/App_Start/**/*.cs;
            **/Fanex.Affiliate.Link/Controllers/HealthController.cs;
            **/Fanex.Affiliate.Link/Views/**/*.cshtml;
            **/Fanex.Affiliate.Link/Workers/**/*.cs;
            **/Fanex.Affiliate.Link.Consumer/ClickTrackingWorker.cs;
            **/Fanex.Affiliate.Link.Consumer/ClickTrackingDLQWorker.cs;
            **/Fanex.Affiliate.Link.Consumer/ClickTrackingRedisStorageWorker.cs;
            **/Fanex.Affiliate.Link/Properties/**/*.cs;
            **/Fanex.Affiliate.Link.Consumer/Properties/**/*.cs;
            **/Fanex.Affiliate.Link.Core/Properties/**/*.cs;
            **/UnitTests/**/*.cs;
            **/*.Tests.cs;
            **/*Test.cs;
            **/*Tests.cs
          </ExcludeByFile>
          <!-- Defensive type-based exclude as well -->
          <Exclude>
            [Fanex.Affiliate.Link]*HealthCheck*;
            [Fanex.Affiliate.Link]*HealthCheck*/*;
            [Fanex.Affiliate.Link]*LoggingConfig*;
            [Fanex.Affiliate.Link]*Program*;
            [Fanex.Affiliate.Link.Consumer]*Program*;
            [Fanex.Affiliate.Link]*Worker*;
            [Fanex.Affiliate.Link.Consumer]*Worker*;
            [*]*Tests*;
            [*]*Test*;
          </Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>


